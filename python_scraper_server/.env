# Variabili d'ambiente per il server Kart Timing
# NON committare questo file nel repository.

# Chiave segreta per firmare i JWT — CAMBIA QUESTO VALORE prima di andare in produzione!
# Genera una chiave sicura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-questa-chiave-con-una-stringa-casuale-sicura

# URL del database (SQLite locale nella cartella data/)
# Non serve modificarlo normalmente.
DATABASE_URL=sqlite:///./data/kart_timing.db
